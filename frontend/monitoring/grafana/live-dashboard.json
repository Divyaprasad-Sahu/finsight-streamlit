{
  "uid": "finsight-live",
  "title": "FinSight Live ML Monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Model training time (seconds)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "finsight_live_fit_seconds",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Inference time (seconds)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "finsight_live_inference_seconds",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Data fetch time (seconds)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "finsight_live_fetch_seconds",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Flagged holdout observations",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "finsight_live_holdout_anomalies",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Market bar age (minutes)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(time() - finsight_live_latest_bar_timestamp_seconds) / 60",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Seconds since successful model run",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "time() - finsight_live_last_success_timestamp_seconds",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Provider requests",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "finsight_live_fetch_total",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Provider errors",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "finsight_live_fetch_errors_total",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Training / holdout rows",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "finsight_live_train_rows or finsight_live_holdout_rows",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Metrics endpoint available",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"finsight-live\"}",
          "refId": "A",
          "legendFormat": "{{__name__}}"
        }
      ]
    }
  ]
}